{
  "name": "emotional-damage-ide",
  "displayName": "Emotional Damage IDE",
  "description": "The most discouraging VS Code extension ever.",
  "version": "0.0.1",
  "publisher": "carenaji2007",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "src/extension.js",
  "activationEvents": [
    "onCommand:emotionalDamageIDE.roast"
  ],
  "contributes": {
    "commands": [
      {
        "command": "emotionalDamageIDE.roast",
        "title": "Emotional Damage IDE: Roast"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "emotionalDamageIDE.roast",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^17.4.2",
    "sound-play": "^1.1.0"
  }
}