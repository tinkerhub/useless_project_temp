# Willow Town — LM Studio AI Configuration

# Model identifier (must match the model loaded in LM Studio)
# Verified identifier exposed by the local LM Studio server
WILLOW_AI_MODEL=prism-ml/bonsai-27b

# Local LM Studio API server (default: http://localhost:1234/v1)
WILLOW_AI_BASE_URL=http://localhost:1234/v1

# Request timeout in seconds (default: 8.0)
WILLOW_AI_TIMEOUT=8.0

# Transport retry count (transport failures only, never retries invalid output)
WILLOW_AI_MAX_RETRIES=1

# Sampling temperature (default: 0.7)
WILLOW_AI_TEMPERATURE=0.7

# Maximum response tokens (default: 512)
WILLOW_AI_MAX_TOKENS=512

# Context token budget (default: 4096)
WILLOW_AI_MAX_CONTEXT_TOKENS=4096

# Minimum cooldown ticks between reasoning requests for the same citizen
WILLOW_AI_COOLDOWN_TICKS=1

# Maximum new character decisions per tick
WILLOW_AI_DECISION_BUDGET=2
